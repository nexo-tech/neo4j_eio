{1 Examples}

{2 Simple Query}

{[
open Neo4j_eio

let create_user session name age =
  let open Query_builder in
  let query =
    raw "CREATE (u:User {name: $name, age: $age}) RETURN u"
    |> with_params [
        ("name", Value.Text name);
        ("age", Value.Int (Int64.of_int age))
       ]
  in
  execute query session
]}

{2 Using Cypher Pipeline}

{[
open Neo4j_eio

let find_adult_users session =
  let open Cypher in
  query "MATCH (u:User) RETURN u.name AS name, u.age AS age"
  |> extract Extract.(pair (text "name") (int "age"))
  |> filter (fun (_, age) -> age >= 18L)
  |> map (List.map fst)  (* Extract just names *)
  |> run session
]}

{2 Transaction DSL}

{[
open Neo4j_eio

let transfer_funds session from_id to_id amount =
  let open Transaction_dsl in
  let tx =
    let* _ = exec_query_builder_unit
      (Query_builder.raw "MATCH (a:Account {id: $id}) SET a.balance = a.balance - $amount"
       |> Query_builder.with_params [
           ("id", Value.Int from_id);
           ("amount", Value.Float amount)
          ])
    in
    let* _ = exec_query_builder_unit
      (Query_builder.raw "MATCH (a:Account {id: $id}) SET a.balance = a.balance + $amount"
       |> Query_builder.with_params [
           ("id", Value.Int to_id);
           ("amount", Value.Float amount)
          ])
    in
    return ()
  in
  Session.transact session tx
]}

